<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Tiered JIT left 1-in-5 timed solves at 5-13 ms (tier-0 to tier-1 swap) in an 11-call run; steady state is fully optimised. -->
    <TieredCompilation>false</TieredCompilation>
    <GridSimRoot Condition="'$(GridSimRoot)' == ''">../../..</GridSimRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(GridSimRoot)/src/GridSim.Core/GridSim.Core.csproj" />
    <!-- gpu-dense / gpu-sparse paths (CUDA through ILGPU) and their CPU-fallback counters (GridSim RC4). -->
    <ProjectReference Include="$(GridSimRoot)/src/GridSim.Gpu/GridSim.Gpu.csproj" />
  </ItemGroup>
</Project>
